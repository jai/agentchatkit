{
  "name": "@jai/agentchat-live",
  "version": "0.0.0",
  "description": "The live chat protocol's server (docs/live-protocol.md in jai/agentchatkit): the room Durable Object, frames, cursors and broadcast, and a conformance suite for a host's adapter.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jai/agentchatkit.git",
    "directory": "server"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "default": "./dist/conformance.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "default": "./dist/memory.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "fixtures": "node scripts/embed-fixtures.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.json",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R ../protocol/fixtures dist/fixtures",
    "test:unit": "node --import ./test/unit/no-network.mjs --test --test-randomize --test-timeout=20000 test/unit/*.test.ts",
    "test:integration": "node --test --test-timeout=20000 test/integration/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "7.0.2",
    "undici": "^8.12.4"
  }
}
